{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{"path": "$DOCUMENT/VectorEngine"}]
    },
    {
      "identifier": "fs:allow-read_text-file",
      "allow": [{"path": "$DOCUMENT/VectorEngine/**"}]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{"path": "$DOCUMENT/VectorEngine/**"}]
    }
  ]
}
